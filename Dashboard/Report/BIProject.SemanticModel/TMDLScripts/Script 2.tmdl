    ref table Financials

        measure 'Revenue YoY ▲▼' =
                IF(
                    ISBLANK([Revenue YoY %]),
                    BLANK(),
                    IF([Revenue YoY %] >= 0, "▲", "▼")
                )
            displayFolder: "09 · Card Formatting"
